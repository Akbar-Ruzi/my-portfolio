# EmailJS settings for the contact form (components/Contact.jsx).
# Copy this file to .env and fill in your own values from https://dashboard.emailjs.com
# NEXT_PUBLIC_ values are built into the browser code, so only put public EmailJS ids here.

# Email Services → your service → Service ID
NEXT_PUBLIC_SERVICE_ID=your_service_id
# Email Templates → your template → Template ID (the template uses {{user_email}}, {{subject}} and {{user_message}})
NEXT_PUBLIC_TEMPLATE_ID=your_template_id
# Account → General → Public Key
NEXT_PUBLIC_PUBLIC_KEY=your_public_key
